<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Distributed outside the Mac App Store: no App Sandbox, because
	     synthesizing input and reading other apps' Accessibility trees are not
	     allowed inside it. Hardened Runtime is on (required for notarization). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
